[Desktop Entry]
Type=Application
Name=Dock & Window
Name[tr]=Dock & Window
Comment=Control FamiliarMac Genie animation and view the system motion preference
Exec=familiarmac-settings --dock-window
Icon=familiarmac-dock-window-symbolic
Categories=Settings;DesktopSettings;
Keywords=Dock;Genie;Animation;Motion;FamiliarMac;
StartupNotify=false
