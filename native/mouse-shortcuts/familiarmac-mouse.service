[Unit]
Description=FamiliarMac optional mouse shortcuts
After=systemd-logind.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/libexec/familiarmac-mouse.py
Restart=on-failure
RestartSec=2
RuntimeDirectory=familiarmac-mouse
RuntimeDirectoryMode=0755
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
