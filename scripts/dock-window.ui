<?xml version='1.0' encoding='utf-8'?>
<interface>
 <object class="AdwNavigationPage" id="dock_page">
  <property name="title">Dock &amp; Window</property>
  <property name="child"><object class="AdwToolbarView">
   <child type="top"><object class="AdwHeaderBar" /></child>
   <property name="content"><object class="AdwPreferencesPage">
    <child><object class="AdwPreferencesGroup">
     <property name="title">Dock</property>
     <child><object class="AdwActionRow"><property name="title">Size</property><child type="suffix"><object class="GtkScale" id="dock_size_scale"><property name="draw-value">False</property><property name="width-request">220</property><property name="margin-start">20</property><property name="margin-end">24</property><property name="valign">center</property><property name="digits">0</property><property name="adjustment"><object class="GtkAdjustment" id="dock_size"><property name="lower">0</property><property name="upper">100</property><property name="step-increment">1</property><property name="page-increment">8</property></object></property></object></child></object></child>
     <child><object class="AdwActionRow" id="dock_zoom_row"><property name="title">Magnification</property><child type="suffix"><object class="GtkScale" id="dock_zoom_scale"><property name="draw-value">False</property><property name="width-request">220</property><property name="margin-start">20</property><property name="margin-end">24</property><property name="valign">center</property><property name="digits">1</property><property name="adjustment"><object class="GtkAdjustment" id="dock_zoom"><property name="lower">0</property><property name="upper">100</property><property name="step-increment">1</property></object></property></object></child></object></child>
     <child><object class="AdwSwitchRow" id="dock_launch_animation"><property name="title">Animate opening applications</property><property name="subtitle">Bounce Dock icons until the app is ready. Uses system animation settings.</property></object></child>
     <child><object class="AdwSwitchRow" id="dock_autohide"><property name="title">Automatically hide and show the Dock</property><property name="subtitle">Move the pointer to the screen edge to reveal it.</property></object></child>
    </object></child>
    <child><object class="AdwPreferencesGroup">
     <property name="title">Window motion</property>
     <property name="description">Minimized windows appear as previews in the Dock.</property>
     <child><object class="AdwSwitchRow" id="genie_switch"><property name="title">Genie animation</property><property name="subtitle">Animate windows when minimizing and restoring.</property></object></child>
     <child><object class="AdwActionRow" id="reduce_motion"><property name="title">System motion preference</property><property name="subtitle">Uses the existing system animation preference.</property></object></child>
    </object></child>
    <child><object class="AdwPreferencesGroup">
     <property name="title">Mission Control</property>
     <child><object class="AdwActionRow"><property name="title">Keyboard and trackpad</property><property name="subtitle">Mission Control shortcuts and the F4 key.</property><child type="suffix"><object class="GtkButton"><property name="name">fm-configure-mission</property><property name="label">Shortcuts…</property><property name="valign">center</property></object></child></object></child>
    </object></child>
    <child><object class="AdwPreferencesGroup" id="applications">
     <property name="title">Application menus</property>
     <property name="description">Configure an application’s menus and shortcut hints in a separate guided check.</property>
    <child><object class="AdwActionRow"><property name="title">Configure Applications</property><property name="subtitle">Choose an app, open it, then check its menus.</property><child type="suffix"><object class="GtkButton"><property name="name">fm-configure-apps</property><property name="label">Configure…</property><property name="valign">center</property></object></child></object></child></object></child>
    <child><object class="AdwPreferencesGroup">
     <property name="title">FamiliarMac</property>
     <property name="description">Desktop updates. Device-specific drivers and repairs are managed separately.</property>
     <child><object class="AdwActionRow" id="release_status"><property name="title">Version</property><property name="subtitle">Checking for updates…</property><child type="suffix"><object class="GtkButton"><property name="name">fm-check-updates</property><property name="label">Check for Updates</property><property name="valign">center</property></object></child></object></child>
     <child><object class="GtkProgressBar" id="release_progress"><property name="visible">False</property><property name="show-text">True</property><property name="margin-top">8</property><property name="margin-bottom">8</property></object></child>
    </object></child>
   </object></property>
  </object></property>
 </object>
 <object class="AdwMessageDialog" id="motion_confirmation">
  <property name="heading">Enable system animations?</property>
  <property name="body">Genie needs system animations. Continuing will also enable animations elsewhere in the desktop.</property>
  <property name="modal">True</property>
  <property name="hide-on-close">True</property>
  <property name="default-response">enable</property>
  <property name="close-response">cancel</property>
  <responses><response id="cancel">Cancel</response><response id="enable" appearance="suggested">Enable</response></responses>
 </object>
</interface>
